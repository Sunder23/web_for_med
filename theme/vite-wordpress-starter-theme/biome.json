{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"files": {
		"includes": [
			"**",
			"!vendor",
			"!assets/dist",
			"!node_modules",
			"!configure/acf/acf-json",
			"!package-lock.json"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"indentWidth": 2,
		"lineEnding": "auto"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	}
}
