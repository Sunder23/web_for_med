{
	"name": "vite-wordpress-theme",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "rimraf ./assets/dist && vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "biome check .",
		"lint:css": "stylelint \"assets/src/scss/**/*.scss\"",
		"format": "biome check --write . && npm run format:css",
		"format:css": "stylelint \"assets/src/scss/**/*.scss\" --fix"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"postcss-pxtorem": "^6.1.0",
		"postcss-scss": "^4.0.9",
		"rimraf": "6.1.3",
		"sass": "1.99.0",
		"stylelint": "^17.16.0",
		"stylelint-scss": "^7.3.0",
		"vite": "8.0.10"
	},
	"dependencies": {
		"@fancyapps/ui": "^6.1.14",
		"aos": "^2.3.4",
		"gsap": "^3.15.0",
		"lenis": "^1.3.23",
		"swiper": "^12.1.4"
	}
}
