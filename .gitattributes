# Normalize all text files to LF in the repo and in every working copy,
# regardless of the local core.autocrlf setting (Biome expects LF).
* text=auto eol=lf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
